# OMCRE8 Studio — Backend Environment Configuration
PORT=4000
NODE_ENV=development

# JWT Secret for Admin Portal authentication
JWT_SECRET=omcre8_super_secure_jwt_secret_change_in_production_2026
ADMIN_EMAIL=admin@omcreate.studio
ADMIN_PASSWORD=admin123

# Studio Contact & Notifications
STUDIO_EMAIL=omyadv@icloud.com
STUDIO_NAME="OMCRE8 Studio"
FOUNDER_NAME="Om Yadav"

# Email Automation (Resend or SMTP)
# If left blank, mock console delivery will log emails cleanly in dev mode
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@omyadav.online

# Calendly Integration
CALENDLY_API_TOKEN=
CALENDLY_USER_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# AI Integration (OpenAI or Google Gemini)
# If blank, the intelligent built-in studio RAG engine is used
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database (Optional Supabase/PostgreSQL URL)
# If blank, local persistent JSON database is used
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
